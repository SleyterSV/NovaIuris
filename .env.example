# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# Runtime: APP_ENV=production requires all private keys and explicit HTTPS origins.
APP_ENV=development
SECRET_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_KEY=
OPENAI_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Required production: absolute paths on a private persistent volume outside the repo.
# CASE_CORPUS_DB_PATH=/var/lib/novaiuris/case_corpus.sqlite3
# TASK_DB_PATH=/var/lib/novaiuris/runtime_tasks.sqlite3
ACTIVE_TASKS_PER_USER=3
PROVIDER_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60
# NovaCourt branch deadlines, measured independently from HTTP requests.
NOVACOURT_TASK_TIMEOUT_SECONDS=1800
NOVACOURT_GRAPH_TIMEOUT_SECONDS=600
NOVACOURT_GRAPH_POLL_INTERVAL_SECONDS=3
NOVACOURT_GRAPH_SETTLE_SECONDS=30
NOVACOURT_PROVIDER_TIMEOUT_SECONDS=60
NOVACOURT_SIMULATION_TIMEOUT_SECONDS=600
# Only the LangGraph Court nodes own simulation provider retries (SDK retries disabled).
NOVACOURT_PROVIDER_MAX_RETRIES=2
NOVACOURT_RETRY_MAX_DELAY_SECONDS=30
AUTH_TIMEOUT_SECONDS=5
# Smoke only; explicit opt-in. Never set in normal CI.
RUN_PROVIDER_SMOKE=0

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
