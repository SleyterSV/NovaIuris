# Backend only. Copy to a private environment file and replace placeholders.
# APP_ENV must be exactly development, test, staging, or production.
APP_ENV=development
SECRET_KEY=replace-with-random-secret-of-at-least-32-characters
LOCAL_DEV_AUTH_ENABLED=false
FLASK_DEBUG=false

# Supabase local examples; staging/production require HTTPS URLs.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=local_publishable_key_from_supabase_status
# Server-side credentials only. Never expose these through VITE_* or browser code.
SUPABASE_KEY=local_server_api_key_from_supabase_status
APP_SUPABASE_SERVICE_ROLE_KEY=local_server_service_role_key_from_supabase_status

# Legal knowledge database and provider credentials (server-side only).
LEGAL_KNOWLEDGE_VERSION=v1
MYKE_LEGAL_DATABASE_URL=postgresql://user:password@localhost:5432/legal
OPENAI_API_KEY=replace-with-provider-secret
LLM_API_KEY=replace-with-provider-secret
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
ZEP_API_KEY=replace-with-provider-secret

# Exact browser origins allowed to call the API; comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_TIMEOUT_SECONDS=5
RATE_LIMIT_ENABLED=true

# Persistent writable paths are required in staging/production and must be
# mounted outside the application checkout.
# CASE_CORPUS_DB_PATH=/var/lib/myke/case_corpus.sqlite3
# TASK_DB_PATH=/var/lib/myke/runtime_tasks.sqlite3
